{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NetsuCast",
  "mainBinaryName": "NetsuCast",
  "version": "0.1.0",
  "identifier": "com.netsucast.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NetsuCast",
        "width": 1280,
        "height": 760,
        "minWidth": 640,
        "minHeight": 400,
        "transparent": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENFQjNGMTFCMjlFRjQxQUQKUldTdFFlOHBHL0d6emdoY3pqbHhpdGdXZEpKVjEwdWlzeGFvWXpJZk9TNFd3NFhrUjNzSHRTdm8K",
      "endpoints": [
        "https://github.com/NetsumaInfo/NetsuCast/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis"
    ],
    "license": "AGPL-3.0-only",
    "licenseFile": "../LICENSE",
    "publisher": "Haim Faraj",
    "homepage": "https://github.com/NetsumaInfo/NetsuCast",
    "copyright": "© 2026 Haim Faraj — AGPL-3.0-only",
    "shortDescription": "Video player with real-time AI upscaling",
    "longDescription": "Video player that continues browser videos with real-time ArtCNN upscaling on the GPU, fed by the NetsuCast browser extension.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/shaders/": "resources/shaders/",
      "../extension/": "extension/",
      "resources/scripts/": "resources/scripts/",
      "resources/tools/mpv/": "tools/mpv/",
      "../LICENSE": "LICENSE"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "French",
          "English"
        ],
        "customLanguageFiles": {
          "French": "windows/netsucast-installer-french.nsh",
          "English": "windows/netsucast-installer-english.nsh"
        },
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installerHooks": "windows/installer-hooks.nsh"
      }
    }
  }
}
