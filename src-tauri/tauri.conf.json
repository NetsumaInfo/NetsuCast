{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NetsuCast",
  "version": "0.1.0",
  "identifier": "com.netsucast.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NetsuCast",
        "width": 1280,
        "height": 760,
        "minWidth": 640,
        "minHeight": 400,
        "transparent": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/shaders/": "resources/shaders/",
      "../extension/": "extension/"
    }
  }
}
