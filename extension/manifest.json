{
  "manifest_version": 3,
  "name": "NetsuCast",
  "version": "0.1.0",
  "description": "Envoie la vidéo de l'onglet vers le lecteur NetsuCast (upscale ArtCNN).",
  "permissions": ["webRequest", "storage", "contextMenus", "cookies"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "NetsuCast",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
