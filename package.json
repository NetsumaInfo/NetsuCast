    "simple-icons": "^16.32.0",
    "tauri-plugin-mpv-api": "0.5.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
