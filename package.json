  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tools": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-tools.ps1",
    "package": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build.ps1",
    "update:manifest": "node scripts/create-update-manifest.mjs",
    "tauri": "tauri",
    "check:i18n": "node scripts/check-i18n.mjs"
  },
